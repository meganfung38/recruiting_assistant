# Copy to .env (never commit .env)
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: point at a different SQLite file (e.g. the baseline variant)
# RECRUITING_DB_PATH=data/recruiting.db
# Optional: some models reject a temperature setting, so it is only sent when you set it
# OPENAI_TEMPERATURE=0.2
# Reasoning effort for the Responses API: none | low (default) | medium. Higher is slower and costs more tokens.
# OPENAI_REASONING_EFFORT=low
